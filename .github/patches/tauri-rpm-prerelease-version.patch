Backport of tauri-apps/tauri#16336 (head b90f29e9) to the Tauri CLI version
package-lock.json pins. Used only by pre-release Linux builds; see the
"Build a Tauri CLI that can bundle a pre-release rpm" step in
.github/workflows/release.yml, and "Pre-releases" in RELEASING.md for when
to remove it.

The rpm crate refuses the `-` in a SemVer pre-release such as 1.0.0-rc.2, so
the stock bundler can't produce an .rpm for one. This writes the rpm's Version
tag as 1.0.0~rc.2 instead, which rpm sorts before 1.0.0. Versions without a
pre-release (1.0.0) come out unchanged. The file name keeps the SemVer form.

diff --git a/crates/tauri-bundler/src/bundle/linux/rpm.rs b/crates/tauri-bundler/src/bundle/linux/rpm.rs
index 9833862dc466..4479cc2d981a 100644
--- a/crates/tauri-bundler/src/bundle/linux/rpm.rs
+++ b/crates/tauri-bundler/src/bundle/linux/rpm.rs
@@ -14,6 +14,29 @@ use tauri_utils::config::RpmCompression;
 
 use super::freedesktop;
 
+/// Converts a SemVer version string to the RPM `Version` tag format.
+///
+/// RPM reserves `-` as the separator between `Version` and `Release`, and the
+/// `rpm` crate (since v0.20) refuses a `Version` that contains it, so it is
+/// replaced with `~`.
+fn to_rpm_version(version: &str) -> String {
+  match semver::Version::parse(version) {
+    Ok(v) if !v.pre.is_empty() || !v.build.is_empty() => {
+      let mut rpm = format!("{}.{}.{}", v.major, v.minor, v.patch);
+      if !v.pre.is_empty() {
+        rpm.push('~');
+        rpm.push_str(&v.pre.as_str().replace('-', "."));
+      }
+      if !v.build.is_empty() {
+        rpm.push('+');
+        rpm.push_str(&v.build.as_str().replace('-', "."));
+      }
+      rpm
+    }
+    _ => version.to_string(),
+  }
+}
