{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reverb",
  "identifier": "dev.zortexsenpai.reverb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reverb",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    },
    "linux": {
      "rpm": {
        "depends": [
          "libasound.so.2()(64bit)",
          "libdbus-1.so.3()(64bit)"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-THE-PUBLIC-KEY-FROM-ISSUE-4",
      "endpoints": [
        "https://github.com/ZortexSenpai/Reverb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
